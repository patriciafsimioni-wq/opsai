# Copy to .env and adjust as needed.

# SQLite (zero-config dev). For Postgres, change the datasource provider in
# prisma/schema.prisma to "postgresql" and set a Postgres connection string here.
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs. Generate a strong value for production:
#   openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-string"
